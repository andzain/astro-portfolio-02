---
import { t, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
  altPath?: string;
}

const {
  title,
  description,
  ogImage = "/images/og/default.jpg",
  lang = "en",
  altPath = "/",
} = Astro.props;

const metaDescription = description ?? t(lang, "site.description");

import MobileNav from "../components/islands/MobileNav.svelte";
import ThemeToggle from "../components/islands/ThemeToggle.svelte";
import LanguageToggle from "../components/islands/LanguageToggle.svelte";
import "../styles/global.css";

const prefix = lang === "en" ? "" : "/hy";
const siteUrl = "https://021920.xyz";

// ✨ NEW: Ensure the image URL is absolute for Schema.org requirements
const absoluteOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage}`;

// ✨ NEW: Define the VisualArtist JSON-LD Schema
const artistSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Vahram Aghasyan",
  url: siteUrl,
  image: absoluteOgImage,
  jobTitle: "Contemporary Artist",
  description: metaDescription,
  inLanguage: lang === "hy" ? "hy" : "en", // ✨ NEW: Tells search engines which language this page is
  sameAs: [
    "https://www.instagram.com/vahramaghasyan",
    // Add Twitter, LinkedIn, or Artsy profiles here later if desired
  ],
};

const navLinks = [
  { href: `${prefix}/`, label: t(lang, "nav.works") },
  { href: `${prefix}/about`, label: t(lang, "nav.about") },
  { href: `${prefix}/contact`, label: t(lang, "nav.contact") },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={Astro.url.href} />
    <link
      rel="alternate"
      hreflang="en"
      href={lang === "en" ? Astro.url.href : new URL(altPath, Astro.url).href}
    />
    <link
      rel="alternate"
      hreflang="hy"
      href={lang === "hy" ? Astro.url.href : new URL(altPath, Astro.url).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <!-- ✨ UPDATED: Use absolute URL for OG as well -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- ✨ NEW: Inject JSON-LD Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(artistSchema)}
    />

    <script is:inline>
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const theme = stored || (prefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={`${prefix}/`} class="logo">Vahram Aghasyan</a>

        <nav class="nav-desktop" aria-label="Primary">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="header-controls">
          <LanguageToggle lang={lang} altPath={altPath} />
          <ThemeToggle client:load />
          <MobileNav client:load links={navLinks} />
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          &copy; {new Date().getFullYear()} Vahram Aghasyan — {
            t(lang, "footer.rights")
          }
        </p>
        <ul class="footer-links">
          <li><a href={`${prefix}/contact`}>{t(lang, "nav.contact")}</a></li>
          <li>
            <a
              href="https://www.instagram.com/vahramaghasyan"
              target="_blank"
              rel="noopener noreferrer">Instagram</a
            >
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
