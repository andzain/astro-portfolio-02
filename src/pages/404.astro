---
import Layout from "../layouts/Layout.astro";
import { t, type Lang } from "../i18n/ui";

const lang: Lang = Astro.url.pathname.startsWith("/hy/") ? "hy" : "en";
const prefix = lang === "en" ? "" : "/hy";
const altPath = lang === "en" ? "/hy/" : "/";
---

<Layout
  title={`${t(lang, "404.title")} — Vahram Aghasyan`}
  lang={lang}
  altPath={altPath}
>
  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1>{t(lang, "404.title")}</h1>
    <p class="not-found-message">{t(lang, "404.message")}</p>
    <a class="not-found-link" href={`${prefix}/`}>{t(lang, "404.cta")}</a>
  </div>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-5) 0;
  }
  .not-found-code {
    font-family: var(--font-serif);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-muted);
    margin: 0;
  }
  .not-found h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.75rem;
    margin: 0;
  }
  .not-found-message {
    color: var(--color-muted);
    max-width: 50ch;
    margin: 0;
  }
  .not-found-link {
    margin-top: var(--space-2);
    padding: 0.6rem 1.5rem;
    background: var(--color-text);
    color: var(--color-bg);
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .not-found-link:hover {
    opacity: 0.85;
  }
</style>
