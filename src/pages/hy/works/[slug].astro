---
import { getCollection } from 'astro:content';
import WorkDetail from '../../../components/templates/WorkDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id }) => id.startsWith('hy/'));
  return projects.map((project) => {
    const slug = project.id.split('/').slice(1).join('/');
    return {
      params: { slug },
      props: { project, slug },
    };
  });
}

const { project, slug } = Astro.props;
---
<WorkDetail project={project} lang="hy" slug={slug} />
